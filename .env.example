# Set in the shell used to start the API and worker. This file is documentation;
# the app does not automatically load .env files. Never commit a real key.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Alternative: absolute path to a private file containing only the key.
# GROQ_API_KEY_FILE=/absolute/path/to/private-groq-key

# Default local JSON credentials: .local/secrets.json with a groq_api string field.
# Optional alternative JSON file path:
# GROQ_SECRETS_FILE=/absolute/path/to/secrets.json
